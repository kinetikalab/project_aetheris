* \\wsl.localhost\Ubuntu\home\minstrel\kinetika\project_mayhem\power_electronics\equivalent_circuit\resonant_H_bridge.asc
Lm1 0 N005 {Lm1}
Lm2 0 N006 {Lm2}
R1 N002 N007 10
Cp N002 0 15p
Cd N002 0 1p
Rd N002 0 192000k
C1 N004 N003 10n
V1 N003 0 SINE(0 19 550000) AC 1
Cw N002 N001 1p
Ls1 N001 N005 {Ls1}
Ls2 N006 N007 {Ls2}
Lb N004 N001 {Lb}
K Lm1 Lm2 1
.ac oct 10000 10000 2000000
;.tran 1m
.param K1=0.995
.param Lm1=L1*K1*K1
.param Ls1=L1*(1-K1*K1)
.param Lm2=L2*K1*K1
.param Ls2=L2*(1-K1*K1)
.param L1=190u
.param L2=190m
.param Lb=15u
.backanno
.end
